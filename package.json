{
  "name": "drama-ready",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Find complete K-drama, C-drama, and J-drama seasons without weekly waiting.",
  "author": "Dan Velton",
  "license": "MIT",
  "homepage": "https://dvelton.github.io/drama-ready/",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvelton/drama-ready.git"
  },
  "bugs": {
    "url": "https://github.com/dvelton/drama-ready/issues"
  },
  "scripts": {
    "refresh": "node scripts/refresh-data.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
